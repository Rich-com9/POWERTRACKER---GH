# Development defaults are safe for local use only.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.70.160,10.0.2.2
CORS_ALLOWED_ORIGINS=
FIREBASE_CREDENTIALS_PATH=C:\path\to\firebase-service-account.json
# Brevo SMTP credentials. Replace these with your own safe values before local use.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-brevo-account-email
EMAIL_HOST_PASSWORD=replace-with-your-brevo-smtp-key
DEFAULT_FROM_EMAIL=your-verified-sender@example.com
